# =============================================================================
# LOOPLY ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================
# Copy this file to .env and provide your environment-specific values.
# DO NOT commit real secrets or production credentials to source control.

# Database (PostgreSQL)
# Prisma connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/looply?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session & Security
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars-long"

# Object Storage (Supabase Storage for bill images - V1 preparation)
# Used in Phase 4 for secure bill image storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="bills"
